# Public IDs, baked into the build. Set them in hPanel > Node.js app > Environment variables, then redeploy.
NEXT_PUBLIC_SITE_URL=https://dallasevmobilecharging.us
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_BEEHQ_SITE_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
# IndexNow key (build writes public/<key>.txt)
INDEXNOW_KEY=
# Company dashboard counter (set both on the host; never commit): the dashboard origin and this site's key
BEEHQ_ORIGIN=
NEXT_PUBLIC_BEEHQ_SITE_ID=
